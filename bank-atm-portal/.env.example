# ============================================================
# .env — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB (Atlas-ready) ────────────────────────────────────
# Local example: mongodb://127.0.0.1:27017/atm_system_db
# Atlas example: mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://CHANGE_ME_USER:CHANGE_ME_PASS@CHANGE_ME_CLUSTER.mongodb.net/atm_system_db?retryWrites=true&w=majority
MONGODB_DB_NAME=atm_system_db
# Optional: fallback URI if primary (Atlas) is unavailable
MONGODB_URI_FALLBACK=mongodb://127.0.0.1:27017/atm_system_db
# Set to false to disable implicit localhost fallback
ENABLE_LOCAL_FALLBACK=true
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_EXPIRES_IN=2m

# ── bcryptjs ─────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Admin Credentials ────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# ── Maintenance Credentials ──────────────────────────────────
MAINTENANCE_USERNAME=technician
MAINTENANCE_PASSWORD=CHANGE_ME

# ── ATM Machine ──────────────────────────────────────────────
ATM_INITIAL_CASH=100000
ATM_MACHINE_NUMBER=ATM-001
