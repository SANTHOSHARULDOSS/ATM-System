# ============================================================
# .env — Environment Configuration
# ============================================================
# IMPORTANT: Never commit this file to version control.
# Add .env to your .gitignore immediately.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────
# Local MongoDB (default):
MONGODB_URI=mongodb://127.0.0.1:27017/atm_system_db

# MongoDB Atlas (cloud — replace with your connection string):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/atm_system_db?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=edc0b070c4f81e7bc836f8d1f44ccc7895e79f007a43fd78c95a5796802cbeb5e02b3eeb72ca235efd920df81f07729ccdf7f125bfd63bb89498e1d8d0fe4745

# Session timeout: 2 minutes (mirrors ATM inactivity timeout)
JWT_EXPIRES_IN=2m

# ── bcryptjs ─────────────────────────────────────────────────
# Higher = more secure but slower. 12 is a good default.
BCRYPT_SALT_ROUNDS=12

# ── Admin Credentials ─────────────────────────────────────────
# Change these before any deployment!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SecureAdminPass123!

# ── ATM Machine ───────────────────────────────────────────────
# Initial physical cash in the ATM ($100,000 default)
ATM_INITIAL_CASH=100000

# ── CORS ──────────────────────────────────────────────────────
# In production, change to your actual frontend domain.
# ALLOWED_ORIGIN=https://yourbank.com
